  "resource_mode": "linux64",
  "resources": {
    "host_ram_gb": 64,
    "max_process_memory_gb": 48,
    "max_cpus": 24,
    "nxf_java_heap_gb": 6,
    "docker_gpus": true,
    "gpu": "",
    "genomad_splits": 8,
    "gtdbtk_pplacer_cpus": 1,
    "gtdbtk_classify_cpus": 4,
    "gtdbtk_min_ram_plus_swap_gb": 150
  },
  "ani": {
    "min_ani_pct": 95,
    "min_af_pct": 50,
    "classification_mode": "candidates_only"
  },
  "mag_review_tsv": "config/approved_mags.tsv",
