  "metaeuk_mmseqs_db": "UniRef50",
  "core_enable_busco": true,
  "core_benchmark_spades": false,
  "benchmark_engines": [],
  "semibin_environment": "global",
  "reference_databases": {
    "kraken2": "",
    "bracken_read_length": 150,
    "phyloflash_silva": "",
    "eggnog_data": "",
    "dbcan": "",
    "genomad": "",
    "checkv": "",
    "gunc": "",
    "gtdbtk": "",
    "metaeuk": "",
    "cat_db": "",
    "skani_representatives": "",
    "kofam": "",
    "eukcc": "",
    "iphop": "",
    "taxprofiler_sheet": "",
    "humann_nucleotide": "",
    "cnps_hmms": "",
    "humann_protein": ""
