// Linux workstation profile for this host:
// AMD Ryzen 9 9950X3D (16 cores / 32 threads), 64 GB RAM,
// NVIDIA RTX PRO 5000 72 GB Blackwell, Docker nvidia runtime.
//
// maxForks = 1 keeps heavy steps sequential. 48 GB is a per-container ceiling
// so the OS keeps a reserve. It is not a RAM reservation.
// GTDB-Tk pplacer is intentionally NOT run inside this ceiling. nf-core/mag
// would request far more than 64 GB for the bacterial reference tree, and a
// 48 GB cgroup would kill it. The separate taxonomy_gtdb stage runs pplacer
// with --pplacer_cpus 1 and a disk scratch directory, using swap when present.
// Do not set --gtdbtk_pplacer_useram or --gtdbtk_use_full_tree.

params {
    max_cpus   = 24
    max_memory = '48.GB'
    max_time   = '240.h'
    // The nf-core/mag 5.5.0 default name "progenomes" is rejected by GUNC 1.1.0.
    // That container accepts progenomes_2.1. The schema enum is still the old name,
    // so validation of this one parameter is skipped below.
    gunc_database_type = 'progenomes_2.1'
}

validation {
    ignoreParams = ['gunc_database_type']
}

docker {
    runOptions = '--gpus all'
    // Containers write as root. Without this, Nextflow cannot read those
    // files when it copies bins and other outputs into results/.
    fixOwnership = true
}

process {
    maxForks = 1
    resourceLimits = [cpus: 24, memory: 48.GB, time: 240.h]
    // The published SemiBin2 and geNomad containers used by nf-core/mag 5.5.0 are CPU images.
    // Forcing --engine gpu or --enable-gpu makes those processes fail. The GPU is still
    // visible to any container that detects CUDA on its own, including CheckM2 when its
    // image ships a CUDA build of PyTorch.
    // COMEBin and MetaBinner are the binners most likely to exceed 64 GB. Ignoring only
    // their failure keeps MetaBAT2, MaxBin2, SemiBin2, CONCOCT and DAS Tool.
    withName: 'COMEBIN_RUNCOMEBIN|METABINNER_METABINNER' {
        errorStrategy = 'ignore'
    }
}

executor {
    queueSize = 1
}
