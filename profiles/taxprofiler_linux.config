// One classifier at a time. The 56 GB setting is the RAM ceiling. --memory-swap -1
// lets the rest of a Kaiju index sit on the NVMe swap file instead of asking Docker
// for a 200 GB RAM container this host cannot start.
docker {
    runOptions = '--memory-swap -1'
    fixOwnership = true
}

process {
    maxForks = 1
    withLabel:process_high {
        cpus   = 8
        memory = 48.GB
    }
    withLabel:process_high_memory {
        cpus   = 8
        memory = 56.GB
    }
}

executor {
    queueSize = 1
}
